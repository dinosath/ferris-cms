{
  "uid": "api::sales-order.sales-order",
  "kind": "collectionType",
  "info": {
    "singularName": "sales-order",
    "pluralName": "sales-orders",
    "displayName": "Sales Order"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "customer_name": { "type": "string" },
    "quantity": { "type": "integer" },
    "unit_price": { "type": "decimal" },
    "discount": { "type": "integer" },
    "subtotal": {
      "type": "decimal",
      "computed": true,
      "expression": "quantity * unit_price",
      "stored": true,
      "dependencies": ["quantity", "unit_price"]
    },
    "discount_amount": {
      "type": "decimal",
      "computed": true,
      "expression": "subtotal * discount / 100",
      "stored": true,
      "dependencies": ["subtotal", "discount"]
    },
    "total_amount": {
      "type": "decimal",
      "computed": true,
      "expression": "subtotal - discount_amount",
      "stored": true,
      "dependencies": ["subtotal", "discount_amount"]
    }
  }
}
