{
  "uid": "api::sales-invoice.sales-invoice",
  "kind": "collectionType",
  "info": {
    "singularName": "sales-invoice",
    "pluralName": "sales-invoices",
    "displayName": "Sales Invoice or Receipt"
  },
  "metadata": {
    "namespace": "erp",
    "labels": { "application": "erp", "domain": "sales", "document": "fiscal" }
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "document_number": { "type": "uid", "required": true, "unique": true, "targetField": "document_number" },
    "document_type": { "type": "enumeration", "enum": ["retail_receipt", "invoice", "credit_note", "proforma"] },
    "status": { "type": "enumeration", "enum": ["draft", "issued", "cancelled", "paid", "partially_paid"] },
    "issued_at": { "type": "datetime" },
    "due_at": { "type": "datetime" },
    "customer": { "type": "relation", "relation": "manyToOne", "target": "api::organization.organization" },
    "lines": { "type": "relation", "relation": "manyToMany", "target": "api::sales-invoice-line.sales-invoice-line" },
    "currency": { "type": "string" },
    "net_amount": { "type": "decimal" },
    "tax_amount": { "type": "decimal" },
    "discount_amount": { "type": "decimal" },
    "total_amount": { "type": "decimal" },
    "amount_paid": { "type": "decimal" },
    "payment_status": { "type": "enumeration", "enum": ["unpaid", "partially_paid", "paid", "refunded"] },
    "notes": { "type": "text" },
    "fiscal_data": { "type": "json" }
  }
}
