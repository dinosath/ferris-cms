{
  "uid": "api::purchase-invoice-line.purchase-invoice-line",
  "kind": "collectionType",
  "info": {
    "singularName": "purchase-invoice-line",
    "pluralName": "purchase-invoice-lines",
    "displayName": "Purchase Invoice Line"
  },
  "metadata": {
    "namespace": "erp",
    "labels": { "application": "erp", "domain": "purchasing", "document": "line" }
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "invoice": { "type": "relation", "relation": "manyToOne", "target": "api::purchase-invoice.purchase-invoice" },
    "product": { "type": "relation", "relation": "manyToOne", "target": "api::product.product" },
    "description": { "type": "string" },
    "quantity": { "type": "decimal", "required": true },
    "unit_cost": { "type": "decimal", "required": true },
    "discount_rate": { "type": "decimal" },
    "tax_rate": { "type": "decimal" },
    "net_amount": { "type": "decimal", "computed": true, "expression": "quantity * unit_cost", "stored": true, "dependencies": ["quantity", "unit_cost"] },
    "tax_amount": { "type": "decimal" },
    "line_total": { "type": "decimal" },
    "lot_number": { "type": "string" },
    "expiry_date": { "type": "date" }
  }
}
