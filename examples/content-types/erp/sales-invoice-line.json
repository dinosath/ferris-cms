{
  "uid": "api::sales-invoice-line.sales-invoice-line",
  "kind": "collectionType",
  "info": {
    "singularName": "sales-invoice-line",
    "pluralName": "sales-invoice-lines",
    "displayName": "Sales Invoice Line"
  },
  "metadata": {
    "namespace": "erp",
    "labels": { "application": "erp", "domain": "sales", "document": "line" }
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "invoice": { "type": "relation", "relation": "manyToOne", "target": "api::sales-invoice.sales-invoice" },
    "product": { "type": "relation", "relation": "manyToOne", "target": "api::product.product" },
    "description": { "type": "string" },
    "quantity": { "type": "decimal", "required": true },
    "unit_price": { "type": "decimal", "required": true },
    "price_rule": { "type": "relation", "relation": "manyToOne", "target": "api::customer-price-rule.customer-price-rule" },
    "price_source": { "type": "enumeration", "enum": ["customer", "customer_group", "default", "manual"] },
    "discount_rate": { "type": "decimal" },
    "tax_rate": { "type": "decimal" },
    "net_amount": { "type": "decimal", "computed": true, "expression": "quantity * unit_price", "stored": true, "dependencies": ["quantity", "unit_price"] },
    "tax_amount": { "type": "decimal" },
    "line_total": { "type": "decimal" }
  }
}
