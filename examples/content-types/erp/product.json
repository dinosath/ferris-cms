{
  "uid": "api::product.product",
  "kind": "collectionType",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product or Service"
  },
  "metadata": {
    "namespace": "erp",
    "labels": { "application": "erp", "domain": "catalog" }
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "sku": { "type": "uid", "required": true, "unique": true, "targetField": "sku" },
    "name": { "type": "string", "required": true },
    "description": { "type": "text" },
    "kind": { "type": "enumeration", "enum": ["product", "service", "bundle"] },
    "unit": { "type": "string" },
    "vat_rate": { "type": "decimal" },
    "sale_price": { "type": "decimal" },
    "cost_price": { "type": "decimal" },
    "track_stock": { "type": "boolean" },
    "barcode": { "type": "string", "unique": true },
    "attributes": { "type": "json" }
  }
}
