{
  "uid": "api::purchase-invoice.purchase-invoice",
  "kind": "collectionType",
  "info": {
    "singularName": "purchase-invoice",
    "pluralName": "purchase-invoices",
    "displayName": "Purchase Invoice"
  },
  "metadata": {
    "namespace": "erp",
    "labels": { "application": "erp", "domain": "purchasing", "document": "fiscal" }
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "document_number": { "type": "uid", "required": true, "unique": true, "targetField": "document_number" },
    "supplier_document_number": { "type": "string" },
    "document_type": { "type": "enumeration", "enum": ["purchase_invoice", "credit_note", "receipt"] },
    "status": { "type": "enumeration", "enum": ["draft", "received", "approved", "cancelled", "paid", "partially_paid"] },
    "received_at": { "type": "datetime" },
    "due_at": { "type": "datetime" },
    "supplier": { "type": "relation", "relation": "manyToOne", "target": "api::organization.organization", "required": true },
    "warehouse": { "type": "relation", "relation": "manyToOne", "target": "api::warehouse.warehouse" },
    "currency": { "type": "string" },
    "net_amount": { "type": "decimal" },
    "tax_amount": { "type": "decimal" },
    "discount_amount": { "type": "decimal" },
    "total_amount": { "type": "decimal" },
    "amount_paid": { "type": "decimal" },
    "payment_status": { "type": "enumeration", "enum": ["unpaid", "partially_paid", "paid", "refunded"] },
    "notes": { "type": "text" },
    "fiscal_data": { "type": "json" }
  }
}
