{
  "uid": "api::customer-price-rule.customer-price-rule",
  "kind": "collectionType",
  "info": {
    "singularName": "customer-price-rule",
    "pluralName": "customer-price-rules",
    "displayName": "Customer Price Rule"
  },
  "metadata": {
    "namespace": "erp",
    "labels": { "application": "erp", "domain": "pricing" }
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "product": { "type": "relation", "relation": "manyToOne", "target": "api::product.product", "required": true },
    "customer": { "type": "relation", "relation": "manyToOne", "target": "api::organization.organization" },
    "customer_group": { "type": "relation", "relation": "manyToOne", "target": "api::customer-group.customer-group" },
    "price_type": { "type": "enumeration", "enum": ["fixed", "discount_percent", "discount_amount"] },
    "value": { "type": "decimal", "required": true },
    "currency": { "type": "string" },
    "minimum_quantity": { "type": "decimal" },
    "valid_from": { "type": "datetime" },
    "valid_until": { "type": "datetime" },
    "priority": { "type": "integer" },
    "active": { "type": "boolean" }
  }
}
